<UserControl x:Class="HashcatGUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:HashcatGUI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Quick Start Section -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionHeader}">
                    <materialDesign:PackIcon Kind="RocketLaunch" VerticalAlignment="Center"/>
                    <Run Text="  Quick Start"/>
                </TextBlock>

                <!-- Hash File Input -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,24,16">
                    <TextBlock Text="Hash File" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding HashFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 materialDesign:HintAssist.Hint="Select hash file..."/>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding BrowseHashFileCommand}"
                                Margin="8,0,0,0">
                            <materialDesign:PackIcon Kind="FolderOpen"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding HashCount, StringFormat={}{0} hash(es) found}"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"
                               Visibility="{Binding HashFilePath, Converter={StaticResource NullToVisibility}}"/>
                </StackPanel>

                <!-- Hash Mode Selection -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Hash Mode" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding FilteredHashModes}"
                              SelectedItem="{Binding SelectedHashMode}"
                              IsEditable="True"
                              Text="{Binding HashModeSearchText, UpdateSourceTrigger=PropertyChanged}"
                              materialDesign:HintAssist.Hint="Search hash mode..."
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" FontWeight="Bold" Width="60"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Attack Mode Selection -->
                <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="300">
                    <TextBlock Text="Attack Mode" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding AttackModes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="AttackMode"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Command="{Binding DataContext.SelectAttackModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Button Style="{StaticResource SuccessButton}"
                            Command="{Binding QuickStartCommand}"
                            IsEnabled="{Binding IsQuickStartReady}"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Configure Attack" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats Cards Row -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Devices Card -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Gpu" Width="24" Height="24" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Devices" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding Devices.Count}"/>
                    <TextBlock Text="Available" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Hash Modes Card -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="LockOpen" Width="24" Height="24" Foreground="{StaticResource InfoBrush}"/>
                        <TextBlock Text="Hash Modes" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding AllHashModes.Count}"/>
                    <TextBlock Text="Supported" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Recent Files Card -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="History" Width="24" Height="24" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="Recent Files" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding RecentHashFiles.Count}"/>
                    <TextBlock Text="Files" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Cracked Card -->
            <Border Grid.Column="3" Style="{StaticResource ModernCard}" Margin="12,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Key" Width="24" Height="24" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="Cracked" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding RecentCrackedHashes.Count}" Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="This Session" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Section -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Recent Hash Files -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}">
                        <materialDesign:PackIcon Kind="FileDocument" VerticalAlignment="Center"/>
                        <Run Text="  Recent Hash Files"/>
                    </TextBlock>

                    <ListBox Grid.Row="1" ItemsSource="{Binding RecentHashFiles}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="8,4"
                                            Command="{Binding DataContext.LoadRecentFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="ArrowRight"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" Text="No recent files" FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding RecentHashFiles.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}"/>
                </Grid>
            </Border>

            <!-- Cracked Hashes -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}">
                        <materialDesign:PackIcon Kind="KeyChain" VerticalAlignment="Center"/>
                        <Run Text="  Recently Cracked"/>
                    </TextBlock>

                    <ListBox Grid.Row="1" ItemsSource="{Binding RecentCrackedHashes}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PrimaryLightBrush}"
                                        CornerRadius="8" Padding="12,8" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Password}" FontWeight="Bold"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontSize="15"/>
                                            <TextBlock Text="{Binding Hash}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="300"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Copy Password"
                                                Click="CopyPassword_Click"
                                                Tag="{Binding Password}">
                                            <materialDesign:PackIcon Kind="ContentCopy"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding RecentCrackedHashes.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                        <materialDesign:PackIcon Kind="LockOpenVariant" Width="48" Height="48"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="No cracked hashes yet" FontStyle="Italic"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
