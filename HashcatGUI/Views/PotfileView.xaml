<UserControl x:Class="HashcatGUI.Views.PotfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:HashcatGUI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="Key" Width="32" Height="32"
                                                  Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="Cracked Passwords (Potfile)" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Border Background="{StaticResource SuccessBrush}" CornerRadius="12"
                                Padding="12,4" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Potfile Path -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding PotfilePath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 materialDesign:HintAssist.Hint="Potfile path..."/>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding BrowsePotfileCommand}" Margin="8,0,0,0"
                                ToolTip="Browse">
                            <materialDesign:PackIcon Kind="FolderOpen"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding RefreshPotfileCommand}" Margin="4,0,0,0"
                                ToolTip="Refresh">
                            <materialDesign:PackIcon Kind="Refresh"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Width="300">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             materialDesign:HintAssist.Hint="Search hashes or passwords..."
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                     VerticalAlignment="Top" Margin="0,0,0,24"/>

        <!-- Hash List -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}">
            <DataGrid ItemsSource="{Binding FilteredHashes}"
                      SelectedItem="{Binding SelectedHash}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Password" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Password}"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontWeight="SemiBold"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Hash" Binding="{Binding Hash}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Hash}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ToolTip="Copy Password" Width="32" Height="32">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.CopyHashCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ToolTip="Copy Hash" Width="32" Height="32">
                                        <materialDesign:PackIcon Kind="Fingerprint" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.CopyAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ToolTip="Copy All" Width="32" Height="32">
                                        <materialDesign:PackIcon Kind="ContentCopyAll" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Empty State -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding FilteredHashes.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
            <materialDesign:PackIcon Kind="DatabaseOff" Width="64" Height="64"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center"/>
            <TextBlock Text="No cracked hashes found" FontSize="16" FontStyle="Italic"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="Configure the potfile path or run an attack to crack passwords"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Margin="0,24,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ExportPotfileCommand}"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Export"/>
                            <TextBlock Text="Export CSV" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ClearPotfileCommand}"
                            Foreground="{StaticResource ErrorBrush}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Delete"/>
                            <TextBlock Text="Clear Potfile" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
