<UserControl x:Class="HashcatGUI.Views.AttackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:HashcatGUI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Basic Configuration -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}">
                    <materialDesign:PackIcon Kind="Cog" VerticalAlignment="Center"/>
                    <Run Text="  Basic Configuration"/>
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Hash File -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,16">
                        <TextBlock Text="Hash File / Wallet *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding HashFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:HintAssist.Hint="Hash file or wallet.dat..."/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding BrowseHashFileCommand}" Margin="8,0,0,0"
                                    ToolTip="Browse for hash file">
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding ImportWalletCommand}" Margin="4,0,0,0"
                                    ToolTip="Import Bitcoin wallet.dat (extracts hash automatically)"
                                    Foreground="{StaticResource AccentBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Wallet"/>
                                    <TextBlock Text="Wallet" Margin="4,0,0,0" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- Wallet Import Status -->
                        <TextBlock Text="{Binding WalletImportStatus}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Visibility="{Binding WalletImportStatus, Converter={StaticResource NullToVisibility}}"/>
                    </StackPanel>

                    <!-- Hash Mode -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,0,16">
                        <TextBlock Text="Hash Mode *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0"
                                     Text="{Binding HashModeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:HintAssist.Hint="Search hash mode (e.g. MD5, Bitcoin, 11300)..."
                                     Margin="0,0,0,8"/>
                            <ComboBox Grid.Row="1"
                                      ItemsSource="{Binding FilteredHashModes}"
                                      SelectedItem="{Binding SelectedHashMode}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      MaxDropDownHeight="400">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" Width="60"/>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Category, StringFormat=' ({0})'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <!-- Attack Mode -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
                        <TextBlock Text="Attack Mode *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AttackModes}"
                                  SelectedItem="{Binding SelectedAttackMode}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id, StringFormat='a={0}'}" FontWeight="Bold" Width="50"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description, StringFormat=' - {0}'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Wordlist Section -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,24"
                Visibility="{Binding ShowWordlistSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}">
                    <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center"/>
                    <Run Text="  Wordlist Configuration"/>
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Primary Wordlist -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Wordlist *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding WordlistPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:HintAssist.Hint="Select wordlist..."/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding BrowseWordlistCommand}" Margin="8,0,0,0">
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Secondary Wordlist -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                Visibility="{Binding ShowSecondWordlistSection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Second Wordlist *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SecondWordlistPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:HintAssist.Hint="Select second wordlist..."/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding BrowseSecondWordlistCommand}" Margin="8,0,0,0">
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Mask/Brute-Force Section -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,24"
                Visibility="{Binding ShowMaskSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}">
                    <materialDesign:PackIcon Kind="ShieldKey" VerticalAlignment="Center"/>
                    <Run Text="  Mask / Brute-Force Configuration"/>
                </TextBlock>

                <!-- Mask Input -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Mask *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 FontFamily="Consolas"
                                 materialDesign:HintAssist.Hint="Enter mask pattern (e.g., ?a?a?a?a)"/>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding BrowseMaskFileCommand}" Margin="8,0,0,0"
                                ToolTip="Load from .hcmask file">
                            <materialDesign:PackIcon Kind="FileDocument"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Built-in Charsets -->
                <TextBlock Text="Built-in Charsets (click to insert)" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,16">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding InsertCharsetCommand}" CommandParameter="?l"
                            Margin="0,0,8,8" Padding="12,4" ToolTip="Lowercase a-z (26 chars)">
                        <TextBlock><Run Text="?l" FontWeight="Bold"/> <Run Text="a-z" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding InsertCharsetCommand}" CommandParameter="?u"
                            Margin="0,0,8,8" Padding="12,4" ToolTip="Uppercase A-Z (26 chars)">
                        <TextBlock><Run Text="?u" FontWeight="Bold"/> <Run Text="A-Z" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding InsertCharsetCommand}" CommandParameter="?d"
                            Margin="0,0,8,8" Padding="12,4" ToolTip="Digits 0-9 (10 chars)">
                        <TextBlock><Run Text="?d" FontWeight="Bold"/> <Run Text="0-9" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding InsertCharsetCommand}" CommandParameter="?s"
                            Margin="0,0,8,8" Padding="12,4" ToolTip="Special characters (33 chars)">
                        <TextBlock><Run Text="?s" FontWeight="Bold"/> <Run Text="!@#$..." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding InsertCharsetCommand}" CommandParameter="?a"
                            Margin="0,0,8,8" Padding="12,4" ToolTip="All printable (95 chars)">
                        <TextBlock><Run Text="?a" FontWeight="Bold"/> <Run Text="all" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding InsertCharsetCommand}" CommandParameter="?h"
                            Margin="0,0,8,8" Padding="12,4" ToolTip="Hex lowercase (16 chars)">
                        <TextBlock><Run Text="?h" FontWeight="Bold"/> <Run Text="hex" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></TextBlock>
                    </Button>
                </WrapPanel>

                <!-- Custom Charsets -->
                <Expander Header="Custom Charsets" Margin="0,0,0,16">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,8">
                            <TextBlock Text="-1 Custom Charset 1 (?1)" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CustomCharset1, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" FontFamily="Consolas"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="8,0,0,8">
                            <TextBlock Text="-2 Custom Charset 2 (?2)" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CustomCharset2, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" FontFamily="Consolas"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,8,0">
                            <TextBlock Text="-3 Custom Charset 3 (?3)" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CustomCharset3, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" FontFamily="Consolas"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="8,0,0,0">
                            <TextBlock Text="-4 Custom Charset 4 (?4)" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CustomCharset4, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </Expander>

                <!-- Increment Mode -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox Content="Increment Mode (-i)"
                              IsChecked="{Binding IncrementMode}"
                              Style="{StaticResource MaterialDesignCheckBox}"/>
                </StackPanel>

                <Grid Visibility="{Binding IncrementMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Increment Min" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding IncrementMin, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Increment Max" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding IncrementMax, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Rules Section -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Margin="0,0,0,24"
                Visibility="{Binding ShowRulesSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}">
                    <materialDesign:PackIcon Kind="CodeBraces" VerticalAlignment="Center"/>
                    <Run Text="  Rules"/>
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Available Rules -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Available Rules" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding AvailableRules}" MaxHeight="200"
                                 Background="{StaticResource PrimaryLightBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SizeFormatted}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.AddRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Add Rule">
                                            <materialDesign:PackIcon Kind="Plus"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Selected Rules -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Selected Rules" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding SelectedRules}" MaxHeight="200"
                                 Background="{StaticResource PrimaryLightBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource ErrorBrush}"
                                                ToolTip="Remove Rule">
                                            <materialDesign:PackIcon Kind="Close"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Performance & Advanced -->
        <Border Grid.Row="4" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}">
                    <materialDesign:PackIcon Kind="Speedometer" VerticalAlignment="Center"/>
                    <Run Text="  Performance &amp; Advanced Options"/>
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Workload Profile -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,16">
                        <TextBlock Text="Workload Profile (-w)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding WorkloadProfiles}"
                                  SelectedItem="{Binding SelectedWorkloadProfile}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="80"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Output File -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="6,0,6,16">
                        <TextBlock Text="Output File (-o)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding OutputFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:HintAssist.Hint="Output file path..."/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding BrowseOutputFileCommand}" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Output Format -->
                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="12,0,0,16">
                        <TextBlock Text="Output Format" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding OutputFormats}"
                                  SelectedItem="{Binding SelectedOutputFormat}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Temperature Limit -->
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,12,16">
                        <TextBlock Text="Temperature Limit (C)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding TemperatureLimit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <!-- Runtime Limit -->
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="6,0,6,16">
                        <TextBlock Text="Runtime Limit (seconds)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding RuntimeLimit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 materialDesign:HintAssist.Hint="No limit"/>
                    </StackPanel>

                    <!-- Checkboxes -->
                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="12,0,0,16">
                        <CheckBox Content="Optimized Kernels (-O)"
                                  IsChecked="{Binding UseOptimizedKernels}"
                                  Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,0,4"/>
                        <CheckBox Content="Force Mode (--force)"
                                  IsChecked="{Binding ForceMode}"
                                  Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,0,4"/>
                        <CheckBox Content="Disable Potfile"
                                  IsChecked="{Binding DisablePotfile}"
                                  Style="{StaticResource MaterialDesignCheckBox}"/>
                    </StackPanel>

                    <!-- Advanced Checkboxes -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Orientation="Horizontal">
                        <CheckBox Content="Loopback Mode"
                                  IsChecked="{Binding LoopbackMode}"
                                  Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,24,0"/>
                        <CheckBox Content="Keep Guessing"
                                  IsChecked="{Binding KeepGuessing}"
                                  Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,24,0"/>
                        <CheckBox Content="Slow Candidates (-S)"
                                  IsChecked="{Binding SlowCandidates}"
                                  Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,24,0"/>
                        <CheckBox Content="Disable Markov"
                                  IsChecked="{Binding MarkovDisable}"
                                  Style="{StaticResource MaterialDesignCheckBox}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Command Preview & Start -->
        <Border Grid.Row="5" Style="{StaticResource ModernCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}">
                    <materialDesign:PackIcon Kind="Console" VerticalAlignment="Center"/>
                    <Run Text="  Command Preview"/>
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1E1E3A" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding CommandPreview}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CopyCommandCommand}"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SuccessButton}"
                                Command="{Binding StartAttackCommand}"
                                IsEnabled="{Binding CanStartAttack}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Start Attack" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,12,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Live Terminal Output -->
        <Border Grid.Row="6" Style="{StaticResource ModernCard}" Margin="0,24,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Terminal Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Console" Width="28" Height="28"
                                                  Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Live Terminal Output" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Border Background="{StaticResource SuccessBrush}" CornerRadius="12" Padding="8,2" Margin="16,0,0,0"
                                Visibility="{Binding IsAttackRunning, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="RUNNING" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding ClearTerminalCommand}"
                                ToolTip="Clear Terminal" Width="36" Height="36">
                            <materialDesign:PackIcon Kind="Delete"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding CopyTerminalCommand}"
                                ToolTip="Copy Output" Width="36" Height="36">
                            <materialDesign:PackIcon Kind="ContentCopy"/>
                        </Button>
                        <ToggleButton Style="{StaticResource MaterialDesignFlatToggleButton}"
                                      IsChecked="{Binding AutoScrollTerminal}"
                                      ToolTip="Auto-scroll" Width="36" Height="36">
                            <materialDesign:PackIcon Kind="ArrowDownBold"/>
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <!-- Terminal Content -->
                <Border Grid.Row="1" Background="#0D0D1A" CornerRadius="8" Padding="0">
                    <ScrollViewer x:Name="TerminalScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TerminalOutput}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Mode=OneWay}"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="12,1"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"
                                             Cursor="IBeam"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Terminal Controls -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Progress Info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Speedometer" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding CurrentSpeed}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ProgressClock" Foreground="{StaticResource InfoBrush}"/>
                                <TextBlock Text="{Binding CurrentProgress, StringFormat='{}{0:F1}%'}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Timer" Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text="{Binding CurrentEta}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Key" Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="{Binding CrackedCount, StringFormat='{}{0} cracked'}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Control Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding PauseAttackCommand}"
                                Visibility="{Binding IsAttackRunning, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pause"/>
                                <TextBlock Text="Pause" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ResumeAttackCommand}"
                                Visibility="{Binding IsAttackPaused, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play"/>
                                <TextBlock Text="Resume" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding StopAttackCommand}"
                                Visibility="{Binding IsAttackRunning, Converter={StaticResource BoolToVisibility}}"
                                Foreground="{StaticResource ErrorBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop"/>
                                <TextBlock Text="Stop" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
