<UserControl x:Class="HashcatGUI.Views.WalletAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:HashcatGUI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- File Selection -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}">
                    <materialDesign:PackIcon Kind="WalletOutline" VerticalAlignment="Center" Width="28" Height="28"/>
                    <Run Text="  Wallet Analyzer"/>
                </TextBlock>

                <TextBlock Text="Analyze a Bitcoin wallet.dat file to determine its age, encryption strength, and get password pattern recommendations."
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding WalletFilePath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             materialDesign:HintAssist.Hint="Select wallet.dat file..."/>

                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding BrowseWalletCommand}" Margin="8,0,0,0"
                            ToolTip="Browse for wallet file">
                        <materialDesign:PackIcon Kind="FolderOpen"/>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource AccentButton}"
                            Command="{Binding AnalyzeWalletCommand}" Margin="8,0,0,0"
                            IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center"/>
                            <TextBlock Text="Analyze" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Status -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,12,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <!-- Loading Indicator -->
                <ProgressBar IsIndeterminate="True" Margin="0,12,0,0"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <!-- Analysis Results -->
        <Grid Grid.Row="1" Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Era & Age Card -->
            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Era Icon -->
                    <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="12"
                            Width="80" Height="80" Margin="0,0,24,0">
                        <materialDesign:PackIcon Kind="ClockTimeFour" Width="48" Height="48"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="White"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EraDisplay}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding YearRangeDisplay}" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding PasswordStyleDisplay}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Encryption Details -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <materialDesign:PackIcon Kind="Lock" VerticalAlignment="Center"/>
                        <Run Text="  Encryption Details"/>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Iteration Count -->
                        <Border Grid.Column="0" Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Iterations" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding IterationCountDisplay}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- File Size -->
                        <Border Grid.Column="1" Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8" Padding="16" Margin="4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="File Size" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding FileSizeDisplay}" FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Keys Found -->
                        <Border Grid.Column="2" Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8" Padding="16" Margin="4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Keys Found" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding KeyCountDisplay}" FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Addresses -->
                        <Border Grid.Column="3" Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Addresses" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AddressCountDisplay}" FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Salt -->
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Salt (Hex)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding SaltDisplay, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                 IsReadOnly="True" Background="{StaticResource PrimaryLightBrush}"
                                 BorderThickness="0" Padding="8" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Address List -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasAddresses, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Bitcoin Addresses" FontSize="11" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding CopyAllAddressesCommand}"
                                    ToolTip="Copy all addresses" Padding="4" Margin="8,0,0,0" Height="24">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                        <Border Background="#0D0D1A" CornerRadius="8" MaxHeight="200" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Analysis.Addresses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="#E0E0E0" Padding="4,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Complexity Score -->
            <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <materialDesign:PackIcon Kind="ShieldLock" VerticalAlignment="Center"/>
                        <Run Text="  Password Complexity Estimate"/>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Complexity Bar -->
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Difficulty Score" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <Grid Height="24" MaxWidth="400" HorizontalAlignment="Left">
                                <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="12"/>
                                <ProgressBar Value="{Binding ComplexityBarWidth, Mode=OneWay}" Maximum="100" Minimum="0"
                                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                                             Foreground="{StaticResource AccentBrush}" Height="24"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Easy" FontSize="10" Foreground="#4CAF50"/>
                                <TextBlock Text=" - " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Medium" FontSize="10" Foreground="#FFC107"/>
                                <TextBlock Text=" - " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Hard" FontSize="10" Foreground="#FF5722"/>
                                <TextBlock Text=" - " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Very Hard" FontSize="10" Foreground="#F44336"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Score Display -->
                        <Border Grid.Column="1" Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8" Padding="24,16" MinWidth="120">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Score" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ComplexityScoreDisplay}" FontSize="28" FontWeight="Bold"
                                           Foreground="{Binding ComplexityColor}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Length Estimate -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Estimated Min Length" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MinLengthDisplay}" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Estimated Max Length" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MaxLengthDisplay}" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Attack Recommendation -->
            <Border Grid.Row="3" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <materialDesign:PackIcon Kind="Lightbulb" VerticalAlignment="Center"/>
                        <Run Text="  Attack Strategy Recommendation"/>
                    </TextBlock>

                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="16">
                        <TextBlock Text="{Binding AttackRecommendation}" TextWrapping="Wrap" FontSize="13"/>
                    </Border>

                    <!-- Likely Patterns -->
                    <TextBlock Text="Likely Password Patterns:" FontSize="12" FontWeight="SemiBold"
                               Margin="0,16,0,8"/>
                    <ItemsControl ItemsSource="{Binding Analysis.Recommendations.LikelyPatterns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16"
                                                              Foreground="{StaticResource SuccessBrush}"
                                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" Margin="8,0,0,0" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Suggested Masks -->
                    <TextBlock Text="Suggested Masks:" FontSize="12" FontWeight="SemiBold"
                               Margin="0,16,0,8"/>
                    <ItemsControl ItemsSource="{Binding Analysis.Recommendations.SuggestedMasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E3A" CornerRadius="4" Padding="8,4" Margin="0,2">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Hashcat Hash -->
            <Border Grid.Row="4" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <materialDesign:PackIcon Kind="Key" VerticalAlignment="Center"/>
                        <Run Text="  Extracted Hash (Mode 11300)"/>
                    </TextBlock>

                    <Border Background="#0D0D1A" CornerRadius="8" Padding="16">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding HashcatHashDisplay}" FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CopyHashCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Hash" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding SaveHashToFileCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center"/>
                                <TextBlock Text="Save Hash" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding GenerateTokenFileCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" VerticalAlignment="Center"/>
                                <TextBlock Text="Token File" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource AccentButton}"
                                Command="{Binding CopyRecommendationsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentMultiple" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Report" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
