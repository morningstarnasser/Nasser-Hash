<UserControl x:Class="HashcatGUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:HashcatGUI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hashcat Path Section -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="Application" Width="28" Height="28"
                                              Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Hashcat Installation" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding HashcatPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             materialDesign:HintAssist.Hint="Path to hashcat.exe"/>
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding BrowseHashcatCommand}" Margin="8,0,0,0">
                        <materialDesign:PackIcon Kind="FolderOpen"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding OpenHashcatFolderCommand}" Margin="4,0,0,0"
                            ToolTip="Open folder in Explorer">
                        <materialDesign:PackIcon Kind="OpenInNew"/>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HashcatFound}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding HashcatVersion}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HashcatFound}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Default Paths Section -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="FolderCog" Width="28" Height="28"
                                              Foreground="{StaticResource InfoBrush}"/>
                    <TextBlock Text="Default Paths" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Wordlist Path -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,16">
                        <TextBlock Text="Wordlists Folder" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DefaultWordlistPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding BrowseWordlistPathCommand}" Margin="8,0,0,0">
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Rules Path -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,0,16">
                        <TextBlock Text="Rules Folder" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DefaultRulesPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding BrowseRulesPathCommand}" Margin="8,0,0,0">
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Masks Path -->
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,12,16">
                        <TextBlock Text="Masks Folder" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DefaultMasksPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding BrowseMasksPathCommand}" Margin="8,0,0,0">
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Output Path -->
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="12,0,0,16">
                        <TextBlock Text="Default Output Folder" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DefaultOutputPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding BrowseOutputPathCommand}" Margin="8,0,0,0">
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Potfile Path -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2">
                        <TextBlock Text="Potfile Path" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PotfilePath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding BrowsePotfileCommand}" Margin="8,0,0,0">
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Default Settings Section -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="Tune" Width="28" Height="28"
                                              Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="Default Attack Settings" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Workload Profile -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Default Workload Profile" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding WorkloadProfiles}"
                                  SelectedValue="{Binding DefaultWorkloadProfile}"
                                  SelectedValuePath="Id"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Id}"/> - <Run Text="{Binding Name}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Output Format -->
                    <StackPanel Grid.Column="1" Margin="6,0">
                        <TextBlock Text="Default Output Format" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding OutputFormats}"
                                  SelectedValue="{Binding DefaultOutputFormat}"
                                  SelectedValuePath="Id"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Temperature Limit -->
                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock Text="Temperature Limit (C)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding TemperatureLimit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <CheckBox Content="Use Optimized Kernels by Default"
                              IsChecked="{Binding UseOptimizedKernels}"
                              Style="{StaticResource MaterialDesignCheckBox}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Devices Section -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="Gpu" Width="28" Height="28"
                                              Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="Available Devices" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding RefreshDevicesCommand}"
                            Margin="16,0,0,0" ToolTip="Refresh devices">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource AccentBrush}"
                                            CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceId, StringFormat='#{0}'}"
                                                   FontWeight="Bold" FontSize="12"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="16,0">
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding DeviceType}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <materialDesign:PackIcon Grid.Column="2" Kind="CheckCircle"
                                                              Width="24" Height="24"
                                                              Foreground="{StaticResource SuccessBrush}"
                                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No devices found. Make sure OpenCL drivers are installed."
                           FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,8,0,0"
                           Visibility="{Binding Devices.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}"/>
            </StackPanel>
        </Border>

        <!-- Save Button -->
        <Border Grid.Row="4">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ResetSettingsCommand}"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restore"/>
                            <TextBlock Text="Reset to Defaults" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SuccessButton}"
                            Command="{Binding SaveSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"/>
                            <TextBlock Text="Save Settings" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
