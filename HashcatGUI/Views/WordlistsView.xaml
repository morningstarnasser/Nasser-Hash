<UserControl x:Class="HashcatGUI.Views.WordlistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:HashcatGUI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Wordlists Section -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="FormatListBulleted" Width="28" Height="28"
                                              Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Wordlists" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Path Selection -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding WordlistSearchPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             materialDesign:HintAssist.Hint="Wordlist folder path..."/>
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding BrowseWordlistFolderCommand}" Margin="8,0,0,0"
                            ToolTip="Browse folder">
                        <materialDesign:PackIcon Kind="FolderOpen"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding RefreshWordlistsCommand}" Margin="4,0,0,0"
                            ToolTip="Refresh list">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                </Grid>

                <!-- Wordlist List -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Wordlists}"
                         SelectedItem="{Binding SelectedWordlist}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="8" Padding="12,8" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.OpenWordlistInExplorerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            ToolTip="Open in Explorer">
                                        <materialDesign:PackIcon Kind="FolderOpen"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Preview -->
                <Expander Grid.Row="3" Header="Preview" IsExpanded="False" Margin="0,12,0,0"
                          Visibility="{Binding SelectedWordlist, Converter={StaticResource NullToVisibility}}">
                    <Border Background="#1E1E3A" CornerRadius="8" Padding="12" Margin="0,8,0,0" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding WordlistPreview}" FontFamily="Consolas" FontSize="11"/>
                        </ScrollViewer>
                    </Border>
                </Expander>

                <!-- Import Button -->
                <Button Grid.Row="3" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ImportWordlistCommand}"
                        HorizontalAlignment="Right" Margin="0,12,0,0"
                        Visibility="{Binding SelectedWordlist, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import"/>
                        <TextBlock Text="Import Wordlist" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Rules Section -->
        <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="12,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="CodeBraces" Width="28" Height="28"
                                              Foreground="{StaticResource InfoBrush}"/>
                    <TextBlock Text="Rules" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Path Selection -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding RulesSearchPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             materialDesign:HintAssist.Hint="Rules folder path..."/>
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding BrowseRulesFolderCommand}" Margin="8,0,0,0"
                            ToolTip="Browse folder">
                        <materialDesign:PackIcon Kind="FolderOpen"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding RefreshRulesCommand}" Margin="4,0,0,0"
                            ToolTip="Refresh list">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                </Grid>

                <!-- Rules List -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Rules}"
                         SelectedItem="{Binding SelectedRule}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="8" Padding="12,8" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="250"
                                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}"/>
                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.OpenRuleInExplorerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            ToolTip="Open in Explorer">
                                        <materialDesign:PackIcon Kind="FolderOpen"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Preview -->
                <Expander Grid.Row="3" Header="Preview" IsExpanded="False" Margin="0,12,0,0"
                          Visibility="{Binding SelectedRule, Converter={StaticResource NullToVisibility}}">
                    <Border Background="#1E1E3A" CornerRadius="8" Padding="12" Margin="0,8,0,0" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding RulePreview}" FontFamily="Consolas" FontSize="11"/>
                        </ScrollViewer>
                    </Border>
                </Expander>

                <!-- Import Button -->
                <Button Grid.Row="3" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ImportRuleCommand}"
                        HorizontalAlignment="Right" Margin="0,12,0,0"
                        Visibility="{Binding SelectedRule, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import"/>
                        <TextBlock Text="Import Rule" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
